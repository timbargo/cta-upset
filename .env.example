# CTA Delay Prediction Configuration

# Required: CTA Bus Tracker API Key
# Get from: https://www.transitchicago.com/developers/bustracker/
CTA_API_KEY=your_cta_api_key_here

# Optional: OpenWeatherMap API Key
# Get from: https://openweathermap.org/api
# Used for weather-based delay predictions
OPENWEATHER_API_KEY=your_weather_api_key_here
